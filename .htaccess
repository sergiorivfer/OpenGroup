RewriteEngine On

# ===== Markdown negotiation for AI agents =====
# Serve markdown when an agent requests Accept: text/markdown
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpe?g|webp|gif|svg|ico|woff2?|ttf|eot|xml|json|pdf|php)$ [NC]
RewriteRule ^(.*)$ md.php?path=$1 [L,QSA]

# Redirigir /inicio a / (evitar duplicados)
Redirect 301 /inicio https://www.opengroupsa.com/

# Asegurar que Apache detecte cambios en index.html
DirectoryIndex index.html

# --- REDIRIGIR .html a URL LIMPIA (funciona en cualquier subdirectorio) ---
RewriteCond %{THE_REQUEST} \.html\sHTTP/ [NC]
RewriteCond %{REQUEST_URI} ^(.*)\.html$ [NC]
RewriteRule ^.*$ %1 [R=301,L,NC]

# --- SERVER HTML CUANDO SE PIDE SIN EXTENSION ---
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Evitar la cache en los archivos HTML
<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
    # Link headers for AI agent discovery (RFC 8288)
    Header set Link '<https://www.opengroupsa.com/.well-known/ai-catalog.json>; rel="ai-catalog", <https://www.opengroupsa.com/.well-known/agent-skills/index.json>; rel="agent-skills", <https://www.opengroupsa.com/sitemap.xml>; rel="sitemap"'
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php80" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
